# ============================================================
# Docker Security Scanner — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values:
#     cp .env.example .env
#
# NEVER commit your real .env file to version control!
#
# Every variable here is read by the scanner. Nothing in this file points at a
# file that does not exist, because a bad HADOLINT_CONFIG or GITLEAKS_CONFIG
# path makes those tools abort — and a scanner that aborts finds no problems.

# ─── Scanner Configuration ───────────────────────────────────
# Comma-separated severity levels to fail the scan on.
# Options: CRITICAL, HIGH, MEDIUM, LOW
FAIL_ON_SEVERITY=CRITICAL,HIGH

# Maximum number of CRITICAL CVEs tolerated before the gate fails.
# 0 means a single CRITICAL fails the build.
CRITICAL_THRESHOLD=0

# Maximum number of HIGH CVEs tolerated. 0 disables the HIGH check entirely.
HIGH_THRESHOLD=10

# Treat Hadolint error-level findings as a policy violation.
FAIL_ON_DOCKERFILE_ERRORS=true

# Fail the gate when a scanner could not run at all.
# Leave this ON. With it off, a missing Trivy binary or an unreadable config
# yields zero findings, and zero findings would be reported as a pass.
FAIL_ON_SCANNER_ERROR=true

# ─── Trivy Settings ──────────────────────────────────────────
# Trivy binary path (leave blank to use PATH)
TRIVY_PATH=

# Trivy DB cache directory. Must be writable by the user running the scan —
# prefer an absolute path when running in a container.
TRIVY_CACHE_DIR=.trivy-cache

# Skip Trivy DB update (useful in air-gapped environments)
TRIVY_SKIP_UPDATE=false

# ─── Hadolint Settings ───────────────────────────────────────
# Hadolint binary path (leave blank to use PATH)
HADOLINT_PATH=

# Optional Hadolint config file. Leave BLANK unless the file exists —
# Hadolint exits with an error if the path cannot be read.
HADOLINT_CONFIG=

# Comma-separated rule IDs to ignore, e.g. DL3008,DL3009
HADOLINT_IGNORE=

# ─── Gitleaks Settings ───────────────────────────────────────
# Gitleaks binary path (leave blank to use PATH)
GITLEAKS_PATH=

# Optional Gitleaks config file. Leave BLANK unless the file exists —
# Gitleaks aborts with a fatal error if the path cannot be read.
GITLEAKS_CONFIG=

# ─── Reporting ───────────────────────────────────────────────
# Output directory for generated reports
REPORT_OUTPUT_DIR=reports

# Formats to generate: html, json, markdown (comma-separated).
# An unrecognised format is an error, not a silent skip.
REPORT_FORMATS=html,json,markdown

# Cap on individual CVE records written to the JSON report (0 = unlimited).
# Summary counts are always complete; this only trims the detail list so a
# 6,000-CVE image does not produce a multi-megabyte CI artifact.
MAX_JSON_VULNERABILITIES=1000

# ─── SBOM Settings ───────────────────────────────────────────
# SBOM formats to generate: cyclonedx, spdx (comma-separated)
SBOM_FORMATS=cyclonedx,spdx

# ─── Logging ─────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave blank to log to stdout only)
LOG_FILE=
